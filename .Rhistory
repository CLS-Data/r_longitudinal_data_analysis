library(labelled)
ncds_50y <- glue("{ncds_fld}/50y/ncds_2008_followup.dta") %>%
read_dta()
mcs_fld <- Sys.getenv("mcs_fld")
ncds_fld <- Sys.getenv("ncds_fld")
ncds_50y <- glue("{ncds_fld}/50y/ncds_2008_followup.dta") %>%
read_dta()
ncds_62y <- glue("{ncds_fld}/62y/ncds10_age62_main_interview.dta") %>%
read_dta()
ncds_55y <- glue("{ncds_fld}/55y/ncds_2013_flatfile.dta") %>%
read_dta()
ncds_55y
ncds_55y %>% lookfor("heioght")
ncds_55y %>% lookfor("weight")
ncds_50y %>% lookfor("weight")
ncds_50y %>% lookfor("kg")
ncds_50y %>% lookfor("^int")
ncds_50y %>% lookfor("int")
ncds_50y %>% lookfor("n(\\d|\\d)int")
ncds_55y
ncds_62y
ncds_62y %>% lookfor(wt)
ncds_62y %>% lookfor("weight")
ncds_44y <- glue("{ncds_fld}/42y-44y Biomedical/ncds42-4_biomedical_eul.dta") %>%
read_dta(col_select = c(ncdsid, htres))
ncds_44y
lookfor(ncds_44y)
lookfor(ncds_50y, "DVHT50")
negative_to_na <- function(x){
na_range(x) <- c(-Inf, -1)
user_na_to_na(x)
}
ncds_44y %>%
mutate(height = negative_to_na(htres)) %>%
select(ncdsid, height) %>%
bind_rows(
ncds_50y %>%
select(ncdsid = NCDSID,
height = DVHT50)
)
ncds_44y %>%
mutate(fup = 44,
height = negative_to_na(htres)) %>%
select(ncdsid, fup, height) %>%
bind_rows(
ncds_50y %>%
mutate(fup = 50) %>%
select(ncdsid = NCDSID,
height = DVHT50)
) %>%
complete(ncdsid, fup) %>%
arrange(ncdsid, fup) %>%
group_by(ncdsid) %>%
fill(height, .direction = "downup")
ncds_44y %>%
mutate(fup = 44,
height = negative_to_na(htres)) %>%
select(ncdsid, fup, height) %>%
bind_rows(
ncds_50y %>%
mutate(fup = 50) %>%
select(ncdsid = NCDSID,
fup,
height = DVHT50)
) %>%
complete(ncdsid, fup) %>%
arrange(ncdsid, fup) %>%
group_by(ncdsid) %>%
fill(height, .direction = "downup")
ncds_44y %>%
mutate(fup = 44,
height = negative_to_na(htres)) %>%
select(ncdsid, fup, height) %>%
bind_rows(
ncds_50y %>%
mutate(fup = 50) %>%
select(ncdsid = NCDSID,
fup,
height = DVHT50)
) %>%
complete(ncdsid, fup) %>%
arrange(ncdsid, fup) %>%
group_by(ncdsid) %>%
fill(height, .direction = "downup") %>%
ungroup()
ncds_44y %>%
mutate(fup = 44,
height = negative_to_na(htres)) %>%
select(ncdsid, fup, height) %>%
bind_rows(
ncds_50y %>%
mutate(fup = 50) %>%
select(ncdsid = NCDSID,
fup,
height = DVHT50)
) %>%
complete(ncdsid, fup) %>%
arrange(ncdsid, fup) %>%
group_by(ncdsid) %>%
fill(height, .direction = "downup") %>%
ungroup() %>%
pivot_wider(names_from = fup,
values_from = height,
names_glue = "height_{fup}")
ncds_50y %>%
mutate(fup = 50) %>%
select(ncdsid = NCDSID,
fup,
height = DVHT50)
ncds_44y %>%
mutate(fup = 44,
height = negative_to_na(htres) / 100) %>%
select(ncdsid, fup, height) %>%
bind_rows(
ncds_50y %>%
mutate(fup = 50) %>%
select(ncdsid = NCDSID,
fup,
height = DVHT50)
) %>%
complete(ncdsid, fup) %>%
arrange(ncdsid, fup) %>%
group_by(ncdsid) %>%
fill(height, .direction = "downup") %>%
ungroup() %>%
pivot_wider(names_from = fup,
values_from = height,
names_glue = "height_{fup}")
#| label: setup
#| include: false
knitr::opts_chunk$set(echo = TRUE)
c(1, 2, 3, 4, 5) + c(2, 4, 6, 1, 2)
c(1, 2, 3) + c(1, 3)
c(1, "two", TRUE)
typeof(1:3)
is.integer(1:3)
is.double(1:3)
is.numeric(1:3) # Both integer and double are 'numeric'
list(
c(1, 2, 3),
c("a", "b"),
c(1, "two", TRUE), # Observe: coerced to a character vector
list(1, "two", TRUE, c(4, 5, 6))
)
head(iris) # An example data.frame
ages <- c("Gary" = 10, "Bertie" = 20, "Peter" = 30)
ages[c(3, 2, 1, 1)]
ages[c(TRUE, FALSE, TRUE)]
ages[c("Bertie", "Gary")]
my_list <- list(
numbers = c(1, 2, 3),
letters = c("a", "b", "c"),
mixed = list(1, "two", TRUE)
)
my_list[c(3, 1)]
my_list[2] # Returns a list of length 1.
my_list[[2]] # Returns a vector
my_list$letters
my_list$lett # Partial matching.
my_df <- data.frame(
name = c("Gary", "Bertie", "Peter"),
age = c(10, 20, 30),
score = c(90, 85, 101),
nationality = factor(c("English", "Scottish", "English"))
)
my_df[[2]] # Extracts the 'age' column as a vector
my_df["age"] # New data.frame only containing 'age' column
my_df[3:2, c("name", "score")] # Extracts first two rows of 'name' and 'score' columns
my_df[, c("name", "score")] # Extracts all rows of 'name' and 'score' columns
library(tibble)
my_tibble <- as_tibble(my_df)
my_df[, "age"] # Returns a vector
my_tibble[, "age"] # Returns a tibble
my_list[["mixed"]][[2]]
variable_dict <- c(age = "Age of Participant", score = "Test Score")
paste("The Average", variable_dict["score"], "is", mean(my_df$score))
ages[ages == 25]
ages[ages >= 20]
ages[ages %in% c(10, 30)]
ages[ages >= 28 | (ages <= 23 & ages != 20)]
ages_na <- c(ages, Dave = NA)
ages_na > 20
ages_na[ages_na > 20]
ages_na[na.omit(ages_na > 20)] # Omits NAs
ages_na[ages_na %in% c(10, NA)]
ages_na[is.na(ages_na)]
which(ages >= 20)
match(ages, c(30, 10, 40))
seq(0, 10, by = 2)
#| code-fold: true
#| code-summary: "Reveal the solution"
#| output: false
my_list$letters[c(3, 1)]
#| code-fold: true
#| code-summary: "Reveal the solution"
#| output: false
my_df[my_df$score == max(my_df$score), c("name", "age")]
attr(my_df, "names")
names(my_df) <- c("Participant_Name", "Participant_Age", "Test_Score", "Nationality")
