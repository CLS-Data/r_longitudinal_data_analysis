df_mini_wide <- list(mcs_11y_mini,
mcs_14y_mini,
mcs_17y_mini) %>%
reduce(
~ full_join(
.x %>% rename(CNUM = matches("CNUM")),
.y %>% rename(CNUM = matches("CNUM")) ,
by = c("MCSID", "CNUM")
)
) %>%
rename_with(~ str_replace(.x, "A0$", "00"))
df_mini_wide
df_mini_wide %>%
pivot_longer(
cols = -c(MCSID, CNUM), # Columns to pivot (everything but MCSID and CNUM)
names_to = "variable",
values_to = "value"
)
df_mini_wide %>%
pivot_longer(
cols = matches("^.C(W|H)TCM00"), # The columns to pivot.
names_pattern = "(..)(.*)", # Two groups: first letter, and subsequent letters
names_to = c("sweep", ".value"))
df_mini_wide %>%
pivot_longer(
cols = matches("^.C(W|H)TCM00"), # The columns to pivot.
names_pattern = "(...)(.*)", # Two groups: first letter, and subsequent letters
names_to = c("sweep", ".value"))
df_mini_wide %>%
pivot_longer(
cols = matches("^.C(W|H)TCM00"), # The columns to pivot.
names_pattern = "(.)(.*)", # Two groups: first letter, and subsequent letters
names_to = c("sweep", ".value"))
df_mini_wide %>%
pivot_longer(
cols = matches("^.C(W|H)TCM00"), # The columns to pivot.
names_pattern = "(.)(.*)", # Two groups: first letter, and subsequent letters
names_to = c("sweep", ".value")
)
df_mini_wide
df_mini_wide %>%
pivot_longer(
cols = matches("^.C(W|H)TCM00"), # The columns to pivot.
names_pattern = "(.)C(..)CM00", # Two groups: first letter, and third and fourth letters
names_to = c("sweep_letter", ".value"))
rename_col <- function(var_name){
var_dict <- c("CHTCM00" = "height", "CWTCM00" = "weight")
sweep_letter <- str_sub(var_name, 1, 1)
clean_var <- var_dict[str_sub(var_name, 2)]
glue("{clean_var}_{mcs_fups[match(sweep_letter, LETTERS)]}")
}
df_mini_wide %>%
mutate(across(where(is.labelled), negative_to_na)) %>%
rename_with(rename_col, .cols = -c(MCSID, CNUM))
df_mini_wide %>%
mutate(across(where(is.labelled), negative_to_na)) %>%
rename_with(rename_col, .cols = -c(MCSID, CNUM)) %>%
pivot_longer(
cols = -c(MCSID, CNUM),
names_pattern = "(.*)_(.*)",
names_to = c(".value", "fup"),
names_transform = list(fup = as.integer) # To change `fup` column from character to integer
)
df_mini_wide %>%
pivot_longer(
cols = matches("^.C(W|H)TCM00"), # The columns to pivot.
names_pattern = "(.)C(.*)CM00", # Two groups: first letter, and subsequent letters
names_to = c("fup", ".value"))
df_mini_wide %>%
pivot_longer(
cols = matches("^.C(W|H)TCM00"), # The columns to pivot.
names_pattern = "(.)C(.*)CM00", # Two groups: first letter, and subsequent letters
names_to = c(".value", "variable"))
df_mini_wide %>%
pivot_longer(
cols = matches("^.C(W|H)TCM00"), # The columns to pivot.
names_pattern = "(.)C(.*)CM00", # Two groups: first letter, and subsequent letters
names_to = c(".value", "variable")) %>%
group_by(
variable
) %>%
summarise(rho = cor(E, `F`, use = "complete.obs"))
df_mini_wide
df_mini_wide %>%
pivot_longer(-c(MCSID, CNUM))
df_mini_wide %>%
pivot_longer(-c(MCSID, CNUM)) %>%
drop_na()
df_mini_wide %>%
pivot_longer(-c(MCSID, CNUM)) %>%
drop_na() %>%
group_by(name) %>%
summarise(mean = mean(value))
df_long_mini <- list(
`11` = mcs_11y_mini %>% rename_with(~ str_replace(.x, "A0$", "00")),
`14` = mcs_14y_mini,
`17` = mcs_17y_mini
) %>%
map_dfr(~ .x %>% rename_with(~ str_sub(.x, 2), .cols = -MCSID),
.id = "fup") %>%
mutate(fup = as.integer(fup)) %>%
arrange(MCSID, CNUM00, fup) %>%
relocate(fup, .after = CNUM00)
df_long_mini
df_long_mini %>%
pivot_wider(
id_cols = c(MCSID, CNUM00),
names_from = fup,
values_from = CHTCM00
)
df_long_mini %>%
pivot_wider(
id_cols = c(MCSID, CNUM00),
names_from = fup,
values_from = CHTCM00,
names_glue = "{.value}_{fup}"
)
df_long_mini %>%
pivot_wider(
id_cols = c(MCSID, CNUM00),
names_from = fup,
values_from = c(CHTCM00, CWTCM00),
names_glue = "{.value}_{fup}"
)
df_long_mini %>%
pivot_wider(
id_cols = c(MCSID, CNUM00),
names_from = fup,
values_from = c(CHTCM00, CWTCM00),
# names_glue = "{.value}_{fup}"
)
df_long_mini %>%
pivot_wider(
id_cols = c(MCSID, CNUM00),
names_from = fup,
values_from = c(CHTCM00, CWTCM00),
names_glue = "{.value}.{fup}"
)
library(tidyverse)
library(broom)
library(lme4)
library(broom.mixed)
library(summarytools)
library(splines)
library(marginaleffects)
rm(list = ls())
df_ncds <- readRDS("data/ncds_updated.Rds")
df_mcs <- readRDS("data/mcs_clean.Rds")
# 1. Repeated Regression Models ----
## A Single Regression Model ----
glimpse(df_ncds)
glimpse(df_mcs)
mod_lm <- lm(bmi ~ verbal_11 + sex + ethnic_group + mother_edu_years + mother_bmi,
data = df_ncds %>% filter(fup == 23))
mod_lm
summary(mod_lm)
tidy(mod_lm, conf.int = TRUE)
tidy(mod_lm, conf.int = TRUE) %>%
filter(term == "verbal_11")
tidy(mod_lm, conf.int = TRUE) %>%
filter(term == "verbal_11") %>%
ggplot() +
aes(x = term, y = estimate, ymin = conf.low, ymax = conf.high) +
geom_hline(yintercept = 0) +
geom_pointrange()
df_ncds %>%
filter(fup == fup)
df_ncds %>%
filter(fup == !!fup)
## A Preliminary Function ----
fup <- 23
df_ncds %>%
filter(fup == !!fup)
## A Preliminary Function ----
rm(fup)
## A Preliminary Function ----
run_lm <- function(fup){
df <- df_ncds %>%
filter(fup == !!fup)
lm(bmi ~ verbal_11 + sex + father_edu_years + mother_bmi,
data = df) %>%
tidy(conf.int = TRUE) %>%
filter(term == "verbal_11") %>%
mutate(fup = !!fup)
}
run_lm(23)
run_lm(16)
unique(df_ncds$fup)
lm_res <- unique(df_ncds$fup) %>%
map_dfr(run_lm)
lm_res
## Plotting the Results ----
ggplot(lm_res) +
aes(x = fup, y = estimate, ymin = conf.low, ymax = conf.high) +
geom_hline(yintercept = 0) +
geom_pointrange()
ggplot(lm_res) +
aes(x = fup, y = estimate, ymin = conf.low, ymax = conf.high) +
geom_hline(yintercept = 0) +
geom_ribbon(alpha = 0.3, color = NA) +
geom_line() +
geom_point()
